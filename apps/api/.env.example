# API (NestJS) — GODZILLA ERP + conteúdo do portfólio.
# Copie para .env e ajuste. Em produção (Vercel), configure como variáveis do projeto, tipo Secret.

# MongoDB. Local: um mongod em modo replica set (transações exigem replica set).
# Produção: string do Atlas (o M0 gratuito já é replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Assina os tokens das empresas demo. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ERP_JWT_SECRET=

# Chave compartilhada com o BFF (apps/web): só com ela a API confia no IP do visitante
# enviado em x-client-ip (rate limit por visitante). Mesmo valor nos dois projetos.
ERP_BFF_KEY=

# Origens liberadas no CORS (separadas por vírgula).
ERP_CORS_ORIGINS=http://localhost:3000

# Máximo de empresas demo ativas ao mesmo tempo (protege os 512 MB do Atlas gratuito).
ERP_MAX_WORKSPACES=300

API_PORT=3001

# Token de instalação: permite criar a conta do dono do sistema UMA vez (em /erp/instalar).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Depois de instalar, a rota fica desativada; pode apagar a variável.
ERP_SETUP_TOKEN=

# Formulário de contato do portfólio: aviso por e-mail (opcional). Sem estas variáveis, as mensagens
# continuam sendo salvas e aparecem no painel do site (/admin) — só não chega o aviso.
# Chave gratuita em https://resend.com; sem domínio próprio, o Resend só envia para o e-mail da sua conta.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=

# GODZILLA Pay (gateway Pix de demonstração) — PostgreSQL. Sem ela, só as rotas /pay respondem 503.
# A integração Neon da Vercel cria DATABASE_URL sozinha; PAY_DATABASE_URL tem prioridade se as duas existirem.
# Use a URL com pooler do Neon (o host tem "-pooler") e sslmode=require. As tabelas são criadas sozinhas.
PAY_DATABASE_URL=

# Segredo do agendador que reenvia webhooks (GET/POST /pay/internal/webhooks/run com
# Authorization: Bearer <segredo>). Mínimo de 16 caracteres; sem ele, o reenvio só acontece
# quando a loja usa a API (e no botão de reenviar).
PAY_CRON_SECRET=

# Máximo de lojas de teste ativas ao mesmo tempo.
PAY_MAX_SANDBOXES=300
