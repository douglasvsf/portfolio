# API (NestJS) — GODZILLA ERP + conteúdo do portfólio.
# Copie para .env e ajuste. Em produção (Vercel), configure como variáveis do projeto, tipo Secret.

# MongoDB. Local: um mongod em modo replica set (transações exigem replica set).
# Produção: string do Atlas (o M0 gratuito já é replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Assina os tokens das empresas demo. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ERP_JWT_SECRET=

# Chave compartilhada com o BFF (apps/web): só com ela a API confia no IP do visitante
# enviado em x-client-ip (rate limit por visitante). Mesmo valor nos dois projetos.
ERP_BFF_KEY=

# Origens liberadas no CORS (separadas por vírgula).
ERP_CORS_ORIGINS=http://localhost:3000

# Máximo de empresas demo ativas ao mesmo tempo (protege os 512 MB do Atlas gratuito).
ERP_MAX_WORKSPACES=300

API_PORT=3001

# Token de instalação: permite criar a conta do dono do sistema UMA vez (em /erp/instalar).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Depois de instalar, a rota fica desativada; pode apagar a variável.
ERP_SETUP_TOKEN=
