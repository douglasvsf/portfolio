NEXT_PUBLIC_API_URL=http://localhost:3001

# Kaiju Stocks (/stocks) — token gratuito em https://brapi.dev/dashboard. Sem ele,
# a listagem funciona, mas o histórico só responde para PETR4, VALE3, ITUB4 e MGLU3.
BRAPI_TOKEN=

# GODZILLA Spotify Stats (/spotify) — crie um app em https://developer.spotify.com/dashboard
# e cadastre o mesmo redirect URI lá. A Spotify não aceita "localhost": use 127.0.0.1.
# Nunca use NEXT_PUBLIC_ nessas variáveis — o secret só existe no servidor.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Modo vitrine: visitantes veem as SUAS estatísticas reais, sem login.
# Gere localmente em /api/spotify/owner-token (logado com a sua conta). Validade: 6 meses.
SPOTIFY_OWNER_REFRESH_TOKEN=
# Last.fm: entrada por nome de usuário (sem limite de contas) e gêneros pelas tags.
# Crie grátis em https://www.last.fm/api/account/create (só a API key é usada).
LASTFM_API_KEY=
# true = todo mundo vê o demo com dados mockados (ignora a vitrine).
MOCK_MODE=false

# Sentry — observabilidade (opcional; sem DSN nada é enviado)
# A DSN é pública. O auth token só é usado no build para subir source maps:
# configure-o apenas na Vercel (tipo Secret), nunca aqui nem com NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_PROJECT=javascript-nextjs
